# ---------------------------------------------------------------------------
# Variables consumed by docker-compose.yml.
#
# Copy this file to `.env` in the same directory (microservices/.env) and
# fill in the secrets. Any unset value falls back to the default shown in
# the compose file (see the `${...:-default}` expressions there).
#
#   cp .env.example .env
#   # edit .env, then:
#   docker compose up --build
#
# Anything per-service that's NOT in this list is hard-coded in the
# compose file itself (e.g. PORT numbers, service URLs).
# ---------------------------------------------------------------------------

# --- DATABASE ---
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=digital_library

# --- RABBITMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- JWT (SHARED ACROSS auth/user/book/borrow) ---
# REQUIRED: change these to your own 32+ char random strings.
ACCESS_SECRET=0b311fe9-1d17-49dd-91aa-740a2a96ba0e
REFRESH_SECRET=472c59e7-86eb-49e5-9552-10ef2d2cc1a5
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --- AUTH-SERVICE EMAIL (Nodemailer + Gmail SMTP) ---
# REQUIRED to make email verification & password reset actually work.
# https://myaccount.google.com/apppasswords (16 chars, spaces ignored).
EMAIL_USER= aurelacocaj1@gmail.com
EMAIL_APP_PASSWORD=nvek pcqu cmnd houg

# --- URLS USED IN OUTBOUND EMAILS ---
# Must be reachable from the user's BROWSER, not just from inside docker.
# Default values match the published ports in docker-compose.yml.
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost

# --- GATEWAY CORS ---
# Browser origins that may call the gateway directly (the dockerized
# frontend talks to the gateway through nginx so this only matters for
# external tools / Postman / a Vite dev server running on the host).
CORS_ORIGIN=http://localhost,http://localhost:5173,http://localhost:8080

# --- GATEWAY HTTPS REDIRECT ---
# Default = enabled in production (gateway is internet-facing). In the
# Docker stack the gateway sits behind nginx serving plain HTTP, so we
# disable the redirect to avoid bouncing every request to a TLS port
# that doesn't exist. Set to false / unset only if you put a real TLS
# terminator (Cloudflare / Caddy / a managed PaaS) in front of the
# gateway directly.
DISABLE_HTTPS_REDIRECT=true

# --- FRONTEND PORT (host side) ---
# Change if port 80 is already in use on your machine. The container
# always serves on 80 internally; this only affects the host mapping.
FRONTEND_PORT=80

# --- GRAFANA ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
