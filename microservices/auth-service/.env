NODE_ENV=development
LOG_FORMAT=pretty
PORT=5001
AUTH_GRPC_PORT=5010
CONSUL_ENABLED=false

MYSQL_URL=mysql://root:@127.0.0.1:3306/digital-library
ACCESS_SECRET=change-me-access-secret-min-32-chars
REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# JWT TTL — pinned explicitly so the value is deterministic across
# environments. Matches the code-level default in authService.js.
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --- EMAIL (Nodemailer + Gmail SMTP) ---
# Gmail account that will appear as the sender.
EMAIL_USER=aurelacocaj1@gmail.com
# 16-char Google App Password (spaces are stripped automatically).
EMAIL_APP_PASSWORD=hhkc ovgz faiq qgct

# --- LINK URLs USED IN EMAILS ---
BACKEND_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# --- Optional debugging ---
# EMAIL_DEBUG=true   # prints full SMTP conversation
# AUTH_SKIP_EMAIL_VERIFY=false
