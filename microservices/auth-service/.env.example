NODE_ENV=development
LOG_FORMAT=pretty
PORT=5001
AUTH_GRPC_PORT=5010
CONSUL_ENABLED=false

MYSQL_URL=mysql://root:password@127.0.0.1:3306/digital-library
ACCESS_SECRET=change-me-access-secret-min-32-chars
REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# --- EMAIL (Nodemailer + Gmail SMTP) ---
# Sender address — defaults to aurelacocaj1@gmail.com when EMAIL_USER is unset.
# EMAIL_USER=aurelacocaj1@gmail.com
# REQUIRED: Gmail App Password (https://myaccount.google.com/apppasswords).
EMAIL_APP_PASSWORD=your-gmail-app-password

# --- LINK URLs USED IN EMAILS ---
# Used to build links in verification & reset emails.
BACKEND_URL=http://localhost:5001
# Used for browser-redirects after GET /auth/reset-password and post-verify CTA.
FRONTEND_URL=http://localhost:5173

# --- TUNABLES (optional) ---
# APP_NAME=Digital Library
# VERIFICATION_TOKEN_TTL=24h
# PASSWORD_RESET_EXPIRES_MS=3600000
# AUTH_SKIP_EMAIL_VERIFY=false
